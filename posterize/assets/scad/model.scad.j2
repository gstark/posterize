}

module original_dowel() {
    // Tight dowel with shallow raised ribs for extra grip.
    // Oriented along Z at the origin; rotate it to align with the plate holes.
    body_length = dowel_length - 2 * dowel_chamfer;
    flat_cut_y = -(dowel_diameter / 2 - dowel_print_flat_depth);

    difference() {
        union() {
            cylinder(h = body_length, d = dowel_diameter, $fn = 64);

            // Shallow circumferential ribs. These slightly compress against the hole wall.
            for (z = [dowel_rib_spacing : dowel_rib_spacing : body_length - dowel_rib_spacing]) {
                translate([0, 0, z - dowel_rib_width / 2])
                    cylinder(h = dowel_rib_width, d = dowel_diameter + 2 * dowel_rib_height, $fn = 64);
            }

            translate([0, 0, body_length])
                cylinder(h = dowel_chamfer, d1 = dowel_diameter, d2 = dowel_diameter - 2 * dowel_chamfer, $fn = 64);

            translate([0, 0, -dowel_chamfer])
                cylinder(h = dowel_chamfer, d1 = dowel_diameter - 2 * dowel_chamfer, d2 = dowel_diameter, $fn = 64);
        }

        // Cut a small flat along one side for horizontal printing.
        translate([-(dowel_diameter + 2 * dowel_rib_height) / 2 - 1, flat_cut_y - 10, -dowel_chamfer - 0.1])
            cube([dowel_diameter + 2 * dowel_rib_height + 2, 10, dowel_length + 0.2]);
    }
}

module printable_dowel() {
    // Render only the dowel, laid flat with the print flat on the bed.
    translate([0, 0, dowel_diameter / 2 - dowel_print_flat_depth])
        rotate([90, 0, 0])
            original_dowel();
}
