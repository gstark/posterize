module aligned_svg(svg_file) {
    scale([scale_factor, scale_factor, 1])
        translate([-raw_cx, -raw_cy, 0])
            import(svg_file);
}

function tile_x0() = plate_w <= {{ unclipped_plate_w }} ? -target_width / 2 : plate_x;
function tile_y0() = plate_w <= {{ unclipped_plate_w }} ? -(raw_height * scale_factor) / 2 : plate_y;
function tile_w() = plate_w <= {{ unclipped_plate_w }} ? target_width : plate_w;
function tile_h() = plate_w <= {{ unclipped_plate_w }} ? raw_height * scale_factor : plate_h;

module tile_region(region_height) {
    translate([tile_x0(), tile_y0(), 0])
        cube([tile_w(), tile_h(), region_height]);
}

module color_layer(svg_file) {
    linear_extrude(height = raised_height)
